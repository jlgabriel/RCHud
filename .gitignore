# =============================================================
#  RCHud — .gitignore
#  Philosophy: the repo versions ONLY our own author Lua code
#  (RCHud/data/modules/) + documentation. The SASL runtime and the
#  .xpl binaries are NOT our code: they come from the SASL package
#  and are overlaid when packaging. Same as the MiniHUD repo does.
# =============================================================

# --- Original reference package (local only, do not version) ---
/MiniHUD/
/MiniHUD.zip

# --- SASL runtime / framework inside the RCHud plugin ---
#     (not our code; shipped with the SASL package)
RCHud/64/
RCHud/liblinux/
RCHud/libmac/
RCHud/libwin/
RCHud/data/api/
RCHud/data/init/
RCHud/data/components/

# --- State generated at runtime (do not version) ---
# state.txt = SASL window state
RCHud/data/modules/state.txt
# rchud_settings.lua = user settings (visibility/units/opacity/background)
RCHud/data/modules/rchud_settings.lua

# --- Packaging output ---
/dist/
*.zip
*.xpl

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
*.log
.vscode/
.idea/
*.swp
*~
